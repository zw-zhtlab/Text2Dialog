# 对话链多平台环境变量配置示例
# 复制此文件为 .env 并填入你的API密钥

# ===================== SiliconFlow AI =====================
# SiliconFlow API配置
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL="https://api.siliconflow.cn/v1"
SILICONFLOW_MODEL_NAME="Qwen/Qwen3-30B-A3B-Instruct-2507"

# ===================== DeepSeek AI =====================
# DeepSeek API配置
DEEPSEEK_API=
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL_NAME="deepseek-chat"

# ===================== 阿里云百炼（DashScope） =====================
# Bailian/Qwen API配置
DASHSCOPE_API_KEY=
BAILIAN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
BAILIAN_MODEL_NAME="qwen-plus"

# ===================== OpenAI =====================
# OpenAI官方API配置
OPENAI_API_KEY=
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL_NAME="gpt-5-mini"

# ===================== 月之暗面Kimi =====================
# Moonshot API配置
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL="https://api.moonshot.cn/v1"
MOONSHOT_MODEL_NAME="kimi-k2-0905-preview"

# ===================== 谷歌 Gemini =====================
# Gemini API配置
GEMINI_API_KEY=
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
GEMINI_MODEL_NAME="gemini-2.0-flash"

# ===================== 亚马逊 Bedrock =====================
# Bedrock API配置
AWS_BEDROCK_API_KEY=
AWS_BEDROCK_BASE_URL="https://bedrock-runtime.us-west-2.amazonaws.com/openai/v1"
AWS_BEDROCK_MODEL_NAME="openai.gpt-oss-20b-1:0"

# ===================== 自定义平台 =====================
# 自定义API端点配置
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL_NAME=

# ===================== 通用配置 =====================
# 选择使用的平台（默认为 siliconflow）
LLM_PLATFORM="siliconflow"

# ===================== 本地服务安全与资源边界 =====================
# 默认仅允许本机访问。远程模式需同时设置 ALLOW_REMOTE=1 和一个强随机 token；
# token 只通过 Authorization: Bearer 或 X-API-Key 请求头发送。
TEXT2DIALOG_ALLOW_REMOTE=0
TEXT2DIALOG_API_TOKEN=

# 默认拒绝解析到私网/环回地址的 BaseURL。仅在明确运行本地模型时开启。
TEXT2DIALOG_ALLOW_LOCAL_MODEL_ENDPOINTS=0

# 按部署容量调整；0 仅在理解禁用上限的影响后使用。
TEXT2DIALOG_MAX_CONCURRENT_JOBS=4
TEXT2DIALOG_MAX_STORED_JOBS=200
TEXT2DIALOG_JOB_RETENTION_SECONDS=604800
TEXT2DIALOG_MAX_UPLOAD_BYTES=33554432
TEXT2DIALOG_MAX_JOB_DISK_BYTES=536870912

# ===================== 使用说明 =====================
# 1. 复制此文件为 .env: cp env.example .env
# 2. 编辑 .env 文件，填入你要使用的平台的API密钥
# 3. 根据需要修改 BASE_URL 和 MODEL_NAME
# 4. 设置 LLM_PLATFORM 为你要使用的平台
# 5. 运行程序：python dialogue_chain.py your_text_file.txt

# ===================== 快速开始示例 =====================
# 使用SiliconFlow：
# SILICONFLOW_API_KEY="your-siliconflow-api-key"
# LLM_PLATFORM="siliconflow"

# 使用DeepSeek：
# DEEPSEEK_API="your-deepseek-api-key"
# LLM_PLATFORM="deepseek"

# 使用OpenAI：
# OPENAI_API_KEY="your-openai-api-key"
# LLM_PLATFORM="openai"

# 使用Kimi：
# MOONSHOT_API_KEY="your-moonshot-api-key"
# LLM_PLATFORM="moonshot"

# 使用Gemini：
# GEMINI_API_KEY="your-gemini-api-key"
# LLM_PLATFORM="gemini"

# 使用Bedrock：
# AWS_BEDROCK_API_KEY="your-bedrock-api-key"
# LLM_PLATFORM="aws_bedrock"
